# Backend URL — set to your deployed Railway/Render URL in production
# Dev: both simulator and physical device on the same network need the machine's LAN IP, not localhost
# Example (LAN): EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
# Example (prod): EXPO_PUBLIC_API_URL=https://origo-backend-production.up.railway.app
EXPO_PUBLIC_API_URL=http://localhost:3001
