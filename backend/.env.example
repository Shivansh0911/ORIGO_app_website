DATABASE_URL=postgresql://user:password@localhost:5432/origo
REDIS_URL=redis://localhost:6379
JWT_SECRET=<generate: openssl rand -hex 32>
JWT_REFRESH_SECRET=<generate: openssl rand -hex 32>
FIELD_ENCRYPTION_KEY=<generate: openssl rand -hex 32>
# SEC-03: Separate key for HMAC blind index (never re-use FIELD_ENCRYPTION_KEY)
BLIND_INDEX_KEY=<generate: openssl rand -hex 32>
RESEND_API_KEY=re_your_key_here
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
# PSEUDO: Supabase Storage — get from supabase.com → Project Settings → API
# Create a public bucket named "origo" in Supabase Storage before setting these
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# AWS (optional — Supabase Storage is preferred; remove these if using Supabase)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=origo-uploads
AWS_REGION=ap-south-1
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# PSEUDO → Get from console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
FCM_SERVER_KEY=your_fcm_key
PORT=4000
NODE_ENV=development
