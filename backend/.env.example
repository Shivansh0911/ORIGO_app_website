# ─── REQUIRED TO BOOT (server refuses to start without these) ────────────────

# ⚠️ Do NOT use Supabase's direct host (db.<ref>.supabase.co). It resolves to
# an IPv6 address ONLY, which is unreachable from many Indian ISP and campus
# networks — this is what blocked our first deploy attempt. Always use the
# connection POOLER host, which has IPv4 addresses.
#
# Local docker:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/origo_db
#   DIRECT_URL=postgresql://postgres:postgres@localhost:5432/origo_db
#
# Supabase production — same pooler host, two different ports:
#   DATABASE_URL  port 6543, TRANSACTION mode, + ?pgbouncer=true   (app runtime)
#   DIRECT_URL    port 5432, SESSION mode                          (migrations only)
#
#   DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#
# Note the username is postgres.<PROJECT_REF> (with the dot), not plain postgres.
# Both URLs are required — Prisma migrations need prepared statements, which
# transaction-mode pooling can't provide, hence the separate DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/origo_db
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/origo_db

# Generate each with: openssl rand -hex 32
# FIELD_ENCRYPTION_KEY and BLIND_INDEX_KEY must be different values, both 64 hex chars
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>
FIELD_ENCRYPTION_KEY=<openssl rand -hex 32>
BLIND_INDEX_KEY=<openssl rand -hex 32>

# ─── REQUIRED FOR FULL FUNCTION (app boots without these, features degrade) ──

# Sessions, OTP, rate limiting. Defaults to localhost:6379 if unset.
# Use Upstash in production: https://console.upstash.com
REDIS_URL=redis://localhost:6379

# File storage (avatars + student IDs). Get from supabase.com → Project Settings → API
# If blank: avatar upload falls back to base64 dev mode; student-ID upload disabled.
# After setting: create buckets "origo" (public) and "origo-private" (private) in Supabase Storage.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key — never expose this client-side>

# OTP email. Get from resend.com → API Keys.
# If blank: OTP is printed to server console only (fine for local dev).
RESEND_API_KEY=

# Google OAuth. Get from console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Must match VITE_GOOGLE_CLIENT_ID in origo-web/.env
# If blank: Google sign-in button is hidden.
GOOGLE_CLIENT_ID=

# ─── PRODUCTION SETTINGS ─────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# CORS allowlist (comma-separated). In dev, auto-allows localhost 3000/5173/4173.
# Set explicitly in production: ALLOWED_ORIGINS=https://yourapp.vercel.app,https://yourapp.com
ALLOWED_ORIGINS=

# ─── PARKED — DO NOT SET until SEC-02 payment rework is complete ─────────────
# Setting these ends mock mode and re-exposes a security exploit.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
