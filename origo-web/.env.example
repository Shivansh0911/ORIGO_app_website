# PSEUDO: Replace with your Railway backend URL after deploying
# Example: VITE_API_URL=https://origo-backend-production.up.railway.app
VITE_API_URL=http://localhost:3001

# PSEUDO: Get from console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID
# Make sure to add your Vercel domain + localhost:3000 to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
